# Names only. Real values live in .env on the server and are never committed.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
API_PORT=
WEB_URL=
API_URL=
# AI provider (leave empty to use the simulated provider)
AI_PROVIDER=
AI_API_KEY=
# Mock mode for the web app: true uses sample data, false calls the real API
NEXT_PUBLIC_USE_MOCK=true
# Base URL of the API for the browser, for example http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=
